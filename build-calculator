function bindMasonryInputs(){
  const d = state.detail;
  const on = (id, get, set)=>{
    const el = document.getElementById(id);
    if(!el) return;
    el.value = get();
    el.addEventListener('input', e=>{ set(parseFloat(e.target.value)||0); refreshOutputs(); });
  };
  if(state.material === 'kirpich'){
    on('cpKirpichPrice', ()=>d.kirpichPrice, v=>d.kirpichPrice=v);
    on('cpCementPrice', ()=>d.cementPrice, v=>d.cementPrice=v);
    on('cpKladkaLabor', ()=>d.kladkaLaborM3, v=>d.kladkaLaborM3=v);
  } else if(MATERIAL_TYPES[state.material] === 'block'){
    const bd = d.block[state.material];
    on('cpBlockM3', ()=>bd.m3, v=>bd.m3=v);
    on('cpBlockBag', ()=>bd.bag, v=>bd.bag=v);
    on('cpBlockLabor', ()=>bd.laborM3, v=>bd.laborM3=v);
  } else if(state.material === 'sip'){
    on('cpSipMaterial', ()=>d.sipMaterial, v=>d.sipMaterial=v);
    on('cpSipLabor', ()=>d.sipLabor, v=>d.sipLabor=v);
  } else {
    on('cpKarkasMaterial', ()=>d.karkasMaterial, v=>d.karkasMaterial=v);
    on('cpKarkasLabor', ()=>d.karkasLabor, v=>d.karkasLabor=v);
  }
}

function updateMasonryNote(){
  const m = MATERIALS[state.material];
  const mm = m.thicknesses[state.thickness].mm;
  let txt = '';
  if(state.material === 'kirpich'){
    txt = `Расход при ${mm} мм: ${bricksPerM2(mm)} шт/м² стены, ${cementBagsPerM2(mm)} мешка цемента/м². Работа считается как ₽/м³ × толщину стены.`;
  } else if(MATERIAL_TYPES[state.material] === 'block'){
    txt = `Расход при ${mm} мм: ${(mm/1000).toFixed(2)} м³ материала/м² стены, ${glueBagsPerM2(mm)} мешка раствора/клея/м². Работа считается как ₽/м³ × толщину стены.`;
  } else {
    txt = `Площадь кладки считается от периметра дома и высоты этажей.`;
  }
  document.getElementById('masonryNote').textContent = txt;
}

