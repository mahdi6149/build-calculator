function renderThicknessButtons(){
  const m = MATERIALS[state.material];
  const row = document.getElementById('thicknessRow');
  row.innerHTML = m.thicknesses.map((t,i)=>`
    <div class="thick-btn small-btn ${i===state.thickness?'active':''}" data-idx="${i}">
      ${t.mm} мм<small>${t.tag}</small>
    </div>
  `).join('');
}

function renderRow3(containerId, options, applyFn, activeIdx){
  const row = document.getElementById(containerId);
  row.innerHTML = options.map((o,i)=>`
    <div class="small-btn ${i===activeIdx?'active':''}" data-idx="${i}">
      ${o.label}<small>${o.tag}</small>
    </div>
  `).join('');
  row.onclick = (e)=>{
    const btn = e.target.closest('.small-btn');
    if(!btn) return;
    applyFn(parseInt(btn.dataset.idx));
    render();
  };
}

function renderSelect(selectId, options, currentIdx, onChange){
  const sel = document.getElementById(selectId);
  sel.innerHTML = options.map((o,i)=>`<option value="${i}">${o.label}</option>`).join('');
  sel.value = currentIdx;
  sel.onchange = (e)=>{ onChange(parseInt(e.target.value)); render(); };
}

