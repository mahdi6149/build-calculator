// ======================= ГЕОМЕТРИЯ =======================

function bricksPerM2(mm){ return Math.round(mm/125*102); }
function cementBagsPerM2(mm){ return +(0.4*(mm/380)).toFixed(2); }
function glueBagsPerM2(mm){ return +(0.2*(mm/300)).toFixed(2); }

function wallGeometry(){
  const fl = FLOORS[state.floors];
  const footprintArea = Math.max(state.area * fl.footprint, 1);
  const perimeter = 4*Math.sqrt(footprintArea) * HOUSE_SHAPE[state.shape].perimeterMult;
  const grossWallArea = perimeter * 3.0 * fl.levels; // высота яруса 3м

  const o = state.openings;
  const winArea = WINDOW_SIZES[o.windowSize].area;
  const openingsArea = o.windowsCount*winArea + o.doorsCount*o.doorArea;
  // защита от абсурдных значений — проёмы не съедают больше половины стены
  const netWallArea = Math.max(grossWallArea - openingsArea, grossWallArea*0.5);

  return { footprintArea, perimeter, grossWallArea, openingsArea, netWallArea };
}

function defaultWindowsCount(){
  return Math.max(3, Math.round(state.area/12));
}
function defaultDoorsCount(){
  return FLOORS[state.floors].levels >= 2 ? 2 : 1;
}

function estimateTimeline(){
  // базовые месяцы на коробку по технологии + масштаб по площади и этажности
  const base = { sip:2.5, karkas:3, gazoblok:4, rakushechnik:4.5, keramzit:4.5, kirpich:6 };
  let months = base[state.material] || 4;
  months *= (0.7 + state.area/250); // масштаб по площади (100м² ≈ ×1.1)
  months *= (1 + (FLOORS[state.floors].levels-1)*0.15); // доп. время на этажность
  if(state.finish === 'rough') months += months*0.35;
  if(state.finish === 'full') months += months*0.7;
  if(state.tsokol.enabled) months += 1;
  const minM = Math.max(1.5, Math.round(months*0.85*10)/10);
  const maxM = Math.round(months*1.2*10)/10;
  return { minM, maxM };
}

function fmt(n){ return Math.round(n).toLocaleString('ru-RU'); }

// ======================= РАСЧЁТ =======================

function computeLineItems(){
  const m = MATERIALS[state.material];
  const area = state.area;
  const regionMult = REGIONS[state.region].mult;
  const thicknessMult = m.thicknesses[state.thickness].mult;
  const thicknessMm = m.thicknesses[state.thickness].mm;
  const fl = FLOORS[state.floors];
  const foundMult = FOUND_TYPE[state.foundType].mult * FOUND_DEPTH[state.foundDepth].mult * FOUND_WIDTH[state.foundWidth].mult;
  const geo = wallGeometry();
  const d = (state.detailMode && state.detail) ? state.detail : null;

  const foundationRange = d ? d.foundation : m.foundation;
  const roofRange = d ? d.roof : m.roof;
  const engRange = d ? d.eng : m.eng;
  const roughRange = d ? d.roughFinish : m.roughFinish;
  const fullRange = d ? d.fullFinish : m.fullFinish;

  const items = [
    { key:'foundation', name:'Фундамент', range:foundationRange, mult: fl.footprint * foundMult * regionMult * HOUSE_SHAPE[state.shape].perimeterMult },
  ];

  // стены
  if(d){
    let matPerM2Wall, laborPerM2Wall;
    if(state.material==='kirpich'){
      const bricks = bricksPerM2(thicknessMm), bags = cementBagsPerM2(thicknessMm);
      matPerM2Wall = bricks*d.kirpichPrice + bags*d.cementPrice;
      laborPerM2Wall = d.kladkaLaborM3 * (thicknessMm/1000);
    } else if(MATERIAL_TYPES[state.material]==='block'){
      const bd = d.block[state.material];
      const bags = glueBagsPerM2(thicknessMm);
      matPerM2Wall = (thicknessMm/1000)*bd.m3 + bags*bd.bag;
      laborPerM2Wall = bd.laborM3 * (thicknessMm/1000);
    } else if(state.material==='sip'){
      matPerM2Wall = d.sipMaterial * thicknessMult;
      laborPerM2Wall = d.sipLabor;
    } else {
      matPerM2Wall = d.karkasMaterial * thicknessMult;
      laborPerM2Wall = d.karkasLabor;
    }
    const wallRatio = geo.netWallArea/area;
    const matPerM2Doma = matPerM2Wall * wallRatio;
    const laborPerM2Doma = laborPerM2Wall * wallRatio;
    items.push({ key:'box', name:`Кладка стен (${thicknessMm} мм) — материал`, range:[matPerM2Doma,matPerM2Doma], mult: fl.boxExtra * regionMult });
    items.push({ key:'boxLabor', name:`Кладка стен (${thicknessMm} мм) — работа`, range:[laborPerM2Doma,laborPerM2Doma], mult: fl.boxExtra * regionMult });
    items.push({ key:'slabs', name:'Перекрытия и монолитные пояса', range: d.slabs, mult: regionMult });
  } else {
    items.push({ key:'box', name:`Коробка (${thicknessMm} мм, ${fl.label.toLowerCase()})`, range:[m.boxBase,m.boxBase], mult: thicknessMult*fl.boxExtra*regionMult*HOUSE_SHAPE[state.shape].perimeterMult });
  }

  items.push({ key:'roof', name:'Кровля', range:roofRange, mult: fl.footprint*regionMult*HOUSE_SHAPE[state.shape].perimeterMult });
  items.push({ key:'floor', name:`Пол (${FLOOR_TYPE[state.floorType].label.toLowerCase()})`, range: (d?d.floor:m.floor), mult: regionMult*FLOOR_TYPE[state.floorType].mult });
  items.push({ key:'windows', name:'Окна', range:WINDOWS[state.windows].range, mult:regionMult });

  // цоколь
  if(state.tsokol.enabled){
    const th = TSOKOL_HEIGHT[state.tsokol.height], tw = TSOKOL_WIDTH[state.tsokol.width], tm = TSOKOL_MATERIAL[state.tsokol.material];
    const volume = geo.perimeter * th.h * tw.w;
    if(d){
      items.push({
        key:'tsokol', name:`Цоколь (${tm.label}, ${tw.label}) — материал`, _abs:true,
        min: volume*d.tsokolMaterial*regionMult, max: volume*d.tsokolMaterial*regionMult,
      });
      items.push({
        key:'tsokolLabor', name:`Цоколь (${tm.label}, ${tw.label}) — работа`, _abs:true,
        min: volume*d.tsokolLabor*regionMult, max: volume*d.tsokolLabor*regionMult,
      });
    } else {
      items.push({
        key:'tsokol', name:`Цоколь (${tm.label}, ${tw.label})`, _abs:true,
        min: volume*tm.pricePerM3[0]*regionMult, max: volume*tm.pricePerM3[1]*regionMult,
      });
    }
    const wpRange = d ? d.waterproof : [3000,5000];
    const wallArea = geo.perimeter*th.h;
    items.push({
      key:'waterproof', name:'Гидроизоляция цоколя', _abs:true,
      min: wallArea*wpRange[0]*regionMult, max: wallArea*wpRange[1]*regionMult,
    });
  }

  if(state.finish !== 'box'){
    items.push({ key:'eng', name:'Инженерные сети', range:engRange, mult:regionMult });
    const finishRange = state.finish === 'full' ? fullRange : roughRange;
    items.push({ key:'finish', name: state.finish === 'full' ? 'Отделка помещений под ключ' : 'Черновая отделка помещений', range: finishRange, mult:regionMult });
  }
  if(FACADE[state.facade].range[1] > 0){
    items.push({ key:'facade', name:'Отделка фасада — ' + FACADE[state.facade].label.split(' ·')[0], range: FACADE[state.facade].range, mult:regionMult });
  }

  return items.map(it => it._abs ? it : ({ ...it, min: it.range[0]*it.mult*area, max: it.range[1]*it.mult*area }));
}

