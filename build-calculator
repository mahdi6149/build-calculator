  document.getElementById('winCountInput').value = state.openings.windowsCount;
  document.getElementById('doorCountInput').value = state.openings.doorsCount;
  document.getElementById('doorAreaInput').value = state.openings.doorArea;
  updateOpeningsNote();
  renderSelect('facadeSelect', FACADE, state.facade, v=>state.facade=v);

  document.getElementById('regionSelect').value = state.region;
  document.getElementById('regionNote').classList.toggle('show', !!REGIONS[state.region].seismic);

  // цоколь
  document.getElementById('tsokolToggle').classList.toggle('active', state.tsokol.enabled);
  document.getElementById('tsokolFilters').classList.toggle('show', state.tsokol.enabled);
  if(state.tsokol.enabled){
    renderRow3('tsokolHeightRow', TSOKOL_HEIGHT, v=>state.tsokol.height=v, state.tsokol.height);
    renderRow3('tsokolMaterialRow', TSOKOL_MATERIAL, v=>state.tsokol.material=v, state.tsokol.material);
    renderRow3('tsokolWidthRow', TSOKOL_WIDTH, v=>state.tsokol.width=v, state.tsokol.width);
  }

  // детальные цены
  document.getElementById('detailToggle').classList.toggle('active', state.detailMode);
  document.getElementById('detailPanel').classList.toggle('show', state.detailMode);
  document.getElementById('detailNote').classList.toggle('show', state.detailMode);
  if(state.detailMode && state.detail){
    ensureMasonryFields();
    if(!simpleDetailBound){
      bindSimpleDetailInputs();
      simpleDetailBound = true;
    }
  }

  refreshOutputs();
  if(state.activeTab === 'advice'){ renderAdvice(); }
}

function refreshOutputs(){
  const items = computeLineItems();
  const totalMin = items.reduce((s,i)=>s+i.min,0);
  const totalMax = items.reduce((s,i)=>s+i.max,0);

  document.getElementById('totalNum').innerHTML = fmt(totalMin) + ' – ' + fmt(totalMax) + ' <sup>₽</sup>';

  const fbody = document.getElementById('forecastBody');
  if(fbody){
    let rows = '';
    for(let y=1; y<=3; y++){
      const lowMin = totalMin*Math.pow(1.05,y), lowMax = totalMax*Math.pow(1.05,y);
      const highMin = totalMin*Math.pow(1.15,y), highMax = totalMax*Math.pow(1.15,y);
      rows += `<tr><td class="name">${2026+y}</td><td class="range">${fmt(lowMin)} – ${fmt(lowMax)}</td><td class="range">${fmt(highMin)} – ${fmt(highMax)}</td></tr>`;
    }
    fbody.innerHTML = rows;
  }
  const perM2Min = totalMin/state.area, perM2Max = totalMax/state.area;
  document.getElementById('perM2').textContent = fmt(perM2Min) + '–' + fmt(perM2Max) + ' ₽/м²';

  const tl = estimateTimeline();
  document.getElementById('timelineEst').textContent = `${tl.minM}–${tl.maxM} мес.`;

  const crewQuery = `${CREW_QUERY[state.material]} ${REGIONS[state.region].label}`;
  document.getElementById('findCrewAvito').href = 'https://yandex.ru/search/?text=' + encodeURIComponent('site:avito.ru ' + crewQuery);
  document.getElementById('findCrewAll').href = 'https://yandex.ru/search/?text=' + encodeURIComponent(crewQuery + ' отзывы контакты');

  document.getElementById('tableBody').innerHTML = items.map(it => `
    <tr><td class="name">${it.name}</td><td class="range">${fmt(it.min)} – ${fmt(it.max)}</td></tr>
  `).join('');

  const bar = document.getElementById('dimBar');
  const legend = document.getElementById('legend');
  bar.innerHTML = ''; legend.innerHTML = '';
  items.forEach(it=>{
    const pct = (it.max/totalMax*100).toFixed(2);
    const seg = document.createElement('div');
    seg.className = 'seg-fill';
    seg.style.width = pct + '%';
    seg.style.background = COLORS[it.key] || '#888';
    seg.textContent = pct > 8 ? pct+'%' : '';
    bar.appendChild(seg);
    const leg = document.createElement('span');
    leg.innerHTML = `<i style="background:${COLORS[it.key]||'#888'}"></i>${it.name}`;
    legend.appendChild(leg);
  });
  document.getElementById('tickMax').textContent = fmt(totalMax) + ' ₽';
}

// ======================= СОБЫТИЯ =======================

document.getElementById('areaInput').addEventListener('input', e=>{
  let v = parseInt(e.target.value)||0;
  v = Math.max(20, Math.min(500, v));
  state.area = v;
  render();
});
document.getElementById('areaSlider').addEventListener('input', e=>{
  state.area = parseInt(e.target.value);
  render();
});
document.getElementById('winCountInput').addEventListener('input', e=>{
  state.openings.windowsCount = Math.max(0, parseInt(e.target.value)||0);
  refreshOutputs(); updateOpeningsNote();
});
document.getElementById('doorCountInput').addEventListener('input', e=>{
  state.openings.doorsCount = Math.max(0, parseInt(e.target.value)||0);
  refreshOutputs(); updateOpeningsNote();
});
document.getElementById('doorAreaInput').addEventListener('input', e=>{
  state.openings.doorArea = parseFloat(e.target.value)||0;
  refreshOutputs(); updateOpeningsNote();
});
document.getElementById('materialSeg').addEventListener('click', e=>{
  const btn = e.target.closest('button');
  if(!btn) return;
  state.material = btn.dataset.val;
  state.thickness = 1;
  render();
});
document.getElementById('thicknessRow').addEventListener('click', e=>{
  const btn = e.target.closest('.thick-btn');
  if(!btn) return;
  state.thickness = parseInt(btn.dataset.idx);
  render();
});
document.getElementById('regionSelect').addEventListener('change', e=>{
  state.region = e.target.value;
  render();
});
document.getElementById('finishList').addEventListener('click', e=>{
  const opt = e.target.closest('.finish-opt');
  if(!opt) return;
  state.finish = opt.dataset.val;
  render();
});
document.getElementById('tsokolToggle').addEventListener('click', ()=>{
  state.tsokol.enabled = !state.tsokol.enabled;
  render();
});
document.getElementById('detailToggle').addEventListener('click', ()=>{
  state.detailMode = !state.detailMode;
  if(state.detailMode && !state.detail){ initDetailDefaults(); }
  render();
});

function renderAdvice(){
  const m = MATERIALS[state.material];
  const mm = m.thicknesses[state.thickness].mm;
  const adv = MATERIAL_ADVICE[state.material];
  const facadeIdx = state.facade;
  const facadeAdv = FACADE_ADVICE[facadeIdx];
  const facadeLabel = FACADE[facadeIdx].label;

  let html = `
    <div class="advice-head">Выбрано сейчас</div>
    <div class="advice-title">${m.label}, ${mm} мм</div>

    <div class="advice-card">
      <h4>Теплопроводность</h4>
      <p>${adv.thermal}</p>
    </div>
    <div class="advice-card">
      <h4>Жара / холод / влажность на Кавказе</h4>
      <p>${adv.climate}</p>
    </div>
    <div class="advice-card">
      <h4>На что обратить внимание</h4>
      <p>${adv.notes}</p>
    </div>
  `;

  if(facadeAdv){
    html += `
      <div class="advice-card facade">
        <h4>Отделка фасада: ${facadeLabel.split(' (')[0]}</h4>
        <p>${facadeAdv}</p>
      </div>
    `;
  }

  html += `
    <div class="advice-disclaimer">Это общие инженерные закономерности (теплопроводность, паропроницаемость, влагостойкость), а не расчёт конкретного дома. Итоговую толщину утепления под ваш участок и микроклимат должен подтвердить проектировщик — перепады температур и влажность заметно отличаются даже в пределах одного региона (побережье / равнина / горы).</div>
  `;

  document.getElementById('adviceView').innerHTML = html;
}

function switchTab(tab){
  state.activeTab = tab;
  document.getElementById('smetaView').style.display = tab === 'smeta' ? '' : 'none';
  document.getElementById('adviceView').style.display = tab === 'advice' ? '' : 'none';
  document.getElementById('tabSmeta').classList.toggle('active', tab === 'smeta');
  document.getElementById('tabAdvice').classList.toggle('active', tab === 'advice');
  if(tab === 'advice') renderAdvice();
}
document.getElementById('tabSmeta').addEventListener('click', ()=>switchTab('smeta'));
document.getElementById('tabAdvice').addEventListener('click', ()=>switchTab('advice'));

document.getElementById('pricesAccordionHead').addEventListener('click', ()=>{
  document.getElementById('pricesAccordion').classList.toggle('open');
});
document.getElementById('forecastAccordionHead').addEventListener('click', ()=>{
  document.getElementById('forecastAccordion').classList.toggle('open');
});

document.getElementById('themeToggle').addEventListener('click', ()=>{
  const isLight = document.body.classList.toggle('theme-light');
  document.getElementById('themeToggle').textContent = isLight ? '☾ Тёмная' : '☀ Светлая';
});

render();
</script>
