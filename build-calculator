<!doctype html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Смета на дом — калькулятор</title>
<style>
  :root{
    --bg: #0f2038;
    --bg-2: #142c4b;
    --panel: #16304f;
    --grid: rgba(255,255,255,0.07);
    --grid-strong: rgba(255,255,255,0.14);
    --ink: #eaf2fb;
    --ink-dim: #8ea3bd;
    --amber: #e8a33d;
    --amber-dim: #6b5327;
    --cyan: #5fd6c4;
    --line: #2a4972;
    --mono: 'JetBrains Mono', 'SF Mono', 'Consolas', ui-monospace, monospace;
    --sans: 'Inter', -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  body.theme-light{
    --bg: #eef1f6;
    --bg-2: #e4e9f1;
    --panel: #ffffff;
    --grid: rgba(22,48,79,0.06);
    --grid-strong: rgba(22,48,79,0.12);
    --ink: #16304f;
    --ink-dim: #64789a;
    --amber: #c9820f;
    --amber-dim: #e7c288;
    --cyan: #0e8a76;
    --line: #d7dfec;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      linear-gradient(var(--grid) 1px, transparent 1px) 0 0/40px 40px,
      linear-gradient(90deg, var(--grid) 1px, transparent 1px) 0 0/40px 40px,
      var(--bg);
    color:var(--ink);
    font-family:var(--sans);
    min-height:100vh;
    padding:32px 20px 60px;
  }

  .wrap{max-width:1040px;margin:0 auto;}

  .eyebrow{
    font-family:var(--mono);
    font-size:12px;
    letter-spacing:.12em;
    color:var(--amber);
    text-transform:uppercase;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    margin-bottom:10px;
  }
  .eyebrow-left{display:flex;align-items:center;gap:10px;}
  .eyebrow-left::before{
    content:"";
    width:22px;height:1px;background:var(--amber);
  }
  .theme-toggle{
    display:flex;
    align-items:center;
    gap:6px;
    background:transparent;
    border:1px solid var(--line);
    color:var(--ink-dim);
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:.06em;
    padding:6px 12px;
    border-radius:2px;
    cursor:pointer;
    transition:.15s;
    text-transform:uppercase;
  }
  .theme-toggle:hover{border-color:var(--amber);color:var(--amber);}

  h1{
    font-family:var(--mono);
    font-weight:700;
    font-size:clamp(28px,4.4vw,42px);
    line-height:1.08;
    margin:0 0 6px;
    letter-spacing:-0.01em;
  }
  .sub{
    color:var(--ink-dim);
    font-size:15px;
    max-width:620px;
    margin:0 0 30px;
  }

  .grid2{
    display:grid;
    grid-template-columns:360px 1fr;
    gap:20px;
  }
  @media (max-width: 780px){
    .grid2{grid-template-columns:1fr;}
  }

  .panel{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:2px;
    padding:22px;
    position:relative;
  }
  .panel::before{
    content: attr(data-tag);
    position:absolute;
    top:-1px; left:16px;
    background:var(--panel);
    border:1px solid var(--line);
    border-top:none;
    font-family:var(--mono);
    font-size:10px;
    letter-spacing:.1em;
    color:var(--ink-dim);
    padding:2px 8px;
    text-transform:uppercase;
  }

  #paramsPanel{}
  #paramsPanel::-webkit-scrollbar{width:6px;}
  #paramsPanel::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px;}

  label{
    display:block;
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:var(--ink-dim);
    margin:20px 0 8px;
  }
  label:first-of-type{margin-top:6px;}

  .area-row{
    display:flex;
    align-items:baseline;
    gap:8px;
    font-family:var(--mono);
  }
  .area-row input[type=number]{
    background:transparent;
    border:none;
    border-bottom:1px solid var(--line);
    color:var(--amber);
    font-family:var(--mono);
    font-size:32px;
    font-weight:700;
    width:110px;
    padding:2px 0;
  }
  .area-row input[type=number]:focus{outline:none;border-color:var(--amber);}
  .area-row span{color:var(--ink-dim);font-size:14px;}

  input[type=range]{
    width:100%;
    margin-top:14px;
    accent-color:var(--amber);
  }

  .seg{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:1px;
    background:var(--line);
    border:1px solid var(--line);
    border-radius:2px;
    overflow:hidden;
  }
  .seg button{
    background:var(--panel);
    border:none;
    color:var(--ink-dim);
    font-family:var(--sans);
    font-size:12px;
    padding:10px 4px;
    cursor:pointer;
    transition:.15s;
  }
  .seg button:hover{color:var(--ink);}
  .seg button.active{
    background:var(--amber);
    color:#1a1200;
    font-weight:600;
  }

  .finish-list{display:flex;flex-direction:column;gap:8px;}
  .finish-opt{
    display:flex;
    align-items:center;
    gap:10px;
    border:1px solid var(--line);
    border-radius:2px;
    padding:10px 12px;
    cursor:pointer;
    font-size:13.5px;
    transition:.15s;
  }
  .finish-opt:hover{border-color:var(--amber-dim);}
  .finish-opt.active{
    border-color:var(--amber);
    background:rgba(232,163,61,0.08);
  }
  .finish-opt .dot{
    width:8px;height:8px;border-radius:50%;
    border:1px solid var(--ink-dim);
    flex:none;
  }
  .finish-opt.active .dot{background:var(--amber);border-color:var(--amber);}
  .finish-opt small{display:block;color:var(--ink-dim);font-size:11.5px;margin-top:2px;}

  .section-title{
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:.1em;
    text-transform:uppercase;
    color:var(--amber);
    margin:26px 0 4px;
    padding-top:16px;
    border-top:1px dashed var(--line);
  }
  .section-title:first-of-type{margin-top:6px;padding-top:0;border-top:none;}

  .cp-group-title{
    font-family:var(--mono);
    font-size:10.5px;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:var(--ink-dim);
    margin:14px 0 8px;
  }
  .cp-group-title:first-child{margin-top:0;}

  .row3{display:flex;gap:6px;}
  .small-btn{
    flex:1;
    background:var(--bg-2);
    border:1px solid var(--line);
    color:var(--ink-dim);
    font-family:var(--mono);
    font-size:11.5px;
    padding:9px 4px;
    border-radius:2px;
    cursor:pointer;
    text-align:center;
    line-height:1.35;
    transition:.15s;
  }
  .small-btn small{display:block;font-family:var(--sans);font-size:9px;color:var(--ink-dim);margin-top:2px;}
  .small-btn:hover{border-color:var(--amber-dim);}
  .small-btn.active{
    border-color:var(--amber);
    background:rgba(201,130,15,0.12);
    color:var(--amber);
  }
  .small-btn.active small{color:var(--amber);}

  select{
    width:100%;
    background:var(--bg-2);
    border:1px solid var(--line);
    color:var(--ink);
    font-family:var(--sans);
    font-size:13.5px;
    padding:10px 12px;
    border-radius:2px;
    appearance:none;
    -webkit-appearance:none;
    background-image: linear-gradient(45deg, transparent 50%, var(--ink-dim) 50%), linear-gradient(135deg, var(--ink-dim) 50%, transparent 50%);
    background-position: calc(100% - 18px) center, calc(100% - 13px) center;
    background-size: 5px 5px, 5px 5px;
    background-repeat:no-repeat;
    cursor:pointer;
  }
  select:focus{outline:none;border-color:var(--amber);}

  .region-note{
    font-size:11.5px;
    color:var(--cyan);
    margin-top:8px;
    font-family:var(--mono);
    display:none;
  }
  .region-note.show{display:block;}

  .toggle-row{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    border:1px solid var(--line);
    border-radius:2px;
    padding:12px;
    cursor:pointer;
    transition:.15s;
  }
  .toggle-row.active{border-color:var(--amber);background:rgba(232,163,61,0.08);}
  .toggle-row span{font-size:13px;}
  .toggle-row span small{display:block;color:var(--ink-dim);font-size:10.5px;margin-top:2px;font-family:var(--sans);}
  .toggle-switch{
    width:34px;height:19px;border-radius:10px;
    background:var(--line);
    position:relative;flex:none;transition:.15s;
  }
  .toggle-switch::after{
    content:"";position:absolute;top:2px;left:2px;
    width:15px;height:15px;border-radius:50%;
    background:var(--ink-dim);transition:.15s;
  }
  .toggle-row.active .toggle-switch{background:var(--amber);}
  .toggle-row.active .toggle-switch::after{left:17px;background:#1a1200;}

  .tsokol-filters{display:none;margin-top:12px;}
  .tsokol-filters.show{display:block;}

  .custom-note{
    display:none;
    font-size:11px;
    color:var(--ink-dim);
    margin-top:8px;
    line-height:1.5;
  }
  .custom-note.show{display:block;}
  .custom-note.inline{margin:6px 0 4px;}

  .custom-prices{
    display:none;
    flex-direction:column;
    gap:9px;
    margin-top:12px;
    padding-top:12px;
    border-top:1px dashed var(--line);
  }
  .custom-prices.show{display:flex;}
  .cp-field{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:8px;
  }
  .cp-field label{
    margin:0;
    font-family:var(--sans);
    text-transform:none;
    letter-spacing:0;
    color:var(--ink);
    font-size:12.5px;
  }
  .cp-inputs{display:flex;gap:5px;align-items:center;font-family:var(--mono);}
  .cp-inputs .dash{color:var(--ink-dim);font-size:11px;}
  .cp-inputs input[type=number]{
    width:66px;
    background:var(--bg-2);
    border:1px solid var(--line);
    color:var(--amber);
    font-family:var(--mono);
    font-size:12px;
    padding:6px 6px;
    border-radius:2px;
  }
  .cp-inputs input[type=number]:focus{outline:none;border-color:var(--amber);}

  /* Right panel: results */
  .total-block{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    flex-wrap:wrap;
    gap:16px;
    border-bottom:1px dashed var(--line);
    padding-bottom:20px;
    margin-bottom:20px;
  }
  .total-num{
    font-family:var(--mono);
    font-size:clamp(28px,4.6vw,42px);
    font-weight:700;
    color:var(--cyan);
    letter-spacing:-0.01em;
  }
  .total-num sup{font-size:14px;color:var(--ink-dim);font-weight:400;margin-left:6px;}
  .per-m2{
    font-family:var(--mono);
    font-size:13px;
    color:var(--ink-dim);
    text-align:right;
  }
  .per-m2 b{color:var(--ink);}

  .dimbar{margin:26px 0 30px;}
  .dimbar .bar{
    display:flex;
    height:34px;
    border:1px solid var(--line);
    border-radius:2px;
    overflow:hidden;
  }
  .dimbar .seg-fill{
    display:flex;
    align-items:center;
    justify-content:center;
    font-family:var(--mono);
    font-size:10px;
    color:#0f2038;
    font-weight:700;
    white-space:nowrap;
    overflow:hidden;
  }
  .dimbar .ticks{
    display:flex;
    justify-content:space-between;
    font-family:var(--mono);
    font-size:9px;
    color:var(--ink-dim);
    margin-top:4px;
  }
  .legend{
    display:flex;
    flex-wrap:wrap;
    gap:14px;
    margin-top:14px;
    font-family:var(--mono);
    font-size:11px;
    color:var(--ink-dim);
  }
  .legend span{display:flex;align-items:center;gap:6px;}
  .legend i{width:9px;height:9px;display:inline-block;border-radius:1px;}

  table{
    width:100%;
    border-collapse:collapse;
    font-size:13.5px;
    margin-top:6px;
  }
  th{
    text-align:left;
    font-family:var(--mono);
    font-size:10.5px;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:var(--ink-dim);
    font-weight:500;
    padding:8px 6px;
    border-bottom:1px solid var(--line);
  }
  th:last-child, td:last-child{text-align:right;}
  td{
    padding:11px 6px;
    border-bottom:1px solid rgba(255,255,255,0.05);
    font-family:var(--mono);
  }
  td.name{font-family:var(--sans);color:var(--ink);}
  td.range{color:var(--ink-dim);}
  .price-table td.range{color:#ff9800;font-weight:600;}

  .tab-row{
    display:flex;
    gap:22px;
    border-bottom:1px solid var(--line);
    margin-bottom:20px;
  }
  .tab-btn{
    background:none;
    border:none;
    color:var(--ink-dim);
    font-family:var(--mono);
    font-size:12px;
    letter-spacing:.06em;
    text-transform:uppercase;
    padding:0 0 10px;
    cursor:pointer;
    border-bottom:2px solid transparent;
    transition:.15s;
  }
  .tab-btn:hover{color:var(--ink);}
  .tab-btn.active{color:var(--amber);border-bottom-color:var(--amber);}

  .advice-head{
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:var(--ink-dim);
    margin-bottom:4px;
  }
  .advice-title{
    font-family:var(--mono);
    font-size:19px;
    font-weight:700;
    color:var(--ink);
    margin-bottom:18px;
  }
  .advice-card{
    border:1px solid var(--line);
    border-left:2px solid var(--amber);
    border-radius:2px;
    padding:14px 16px;
    margin-bottom:12px;
  }
  .advice-card h4{
    font-family:var(--mono);
    font-size:10.5px;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:var(--amber);
    margin:0 0 8px;
  }
  .advice-card p{
    font-size:13px;
    line-height:1.65;
    color:var(--ink);
    margin:0;
  }
  .advice-card.facade{border-left-color:var(--cyan);}
  .advice-card.facade h4{color:var(--cyan);}
  .advice-disclaimer{
    font-size:11.5px;
    color:var(--ink-dim);
    line-height:1.6;
    font-family:var(--mono);
    margin-top:18px;
    padding-top:14px;
    border-top:1px dashed var(--line);
  }

  .accordion{
    border:1px solid var(--line);
    border-radius:2px;
    margin-bottom:16px;
    overflow:hidden;
  }
  .accordion-head{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    padding:13px 16px;
    cursor:pointer;
    background:var(--bg-2);
    transition:.15s;
  }
  .accordion-head:hover{background:var(--line);}
  .accordion-head .label{
    display:flex;
    align-items:center;
    gap:8px;
    font-family:var(--mono);
    font-size:12.5px;
    letter-spacing:.04em;
    color:var(--ink);
  }
  .accordion-chevron{
    color:var(--ink-dim);
    font-family:var(--mono);
    font-size:11px;
    transition:transform .2s ease;
    flex:none;
  }
  .accordion.open .accordion-chevron{transform:rotate(90deg);}
  .accordion-body{
    max-height:0;
    overflow:hidden;
    transition:max-height .3s ease;
  }
  .accordion.open .accordion-body{max-height:2400px;}
  .accordion-inner{padding:16px;}

  .hidden-costs{
    margin-top:22px;
    border:1px dashed var(--line);
    border-radius:2px;
    padding:16px 18px;
  }
  .hidden-costs h3{
    font-family:var(--mono);
    font-size:12px;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:var(--amber);
    margin:0 0 10px;
  }
  .hidden-costs ul{
    margin:0;padding-left:18px;
    font-size:13px;
    color:var(--ink-dim);
    line-height:1.7;
  }
  .hidden-costs li b{color:var(--ink);font-weight:600;}

  .foot-note{
    margin-top:24px;
    font-size:11.5px;
    color:var(--ink-dim);
    line-height:1.6;
    font-family:var(--mono);
  }
</style>
</head>
<body>
<div class="wrap">

  <div class="eyebrow">
    <span class="eyebrow-left">Смета · 2026</span>
    <button class="theme-toggle" id="themeToggle">☀ Светлая</button>
  </div>
  <h1>Сколько будет<br/>стоить дом</h1>
  <p class="sub">Ориентировочный расчёт по рыночным ценам на строительство на Северном Кавказе и Юге России, 2026 год. Двигайте параметры — смета пересчитывается сразу. Включите «Детальные цены», чтобы задать стоимость кирпича, цемента, блока и работы отдельно.</p>

  <div class="grid2">

    <!-- LEFT: inputs -->
    <div class="panel" data-tag="Параметры" id="paramsPanel">

      <div class="section-title">Габариты</div>
      <label>Площадь дома</label>
      <div class="area-row">
        <input type="number" id="areaInput" value="100" min="20" max="500" />
        <span>м²</span>
      </div>
      <input type="range" id="areaSlider" min="20" max="500" value="100" step="5" />

      <label>Этажность</label>
      <div class="row3" id="floorsRow"></div>

      <label>Форма дома</label>
      <div class="row3" id="shapeRow"></div>

      <div class="section-title">Стены</div>
      <label>Материал</label>
      <div class="seg" id="materialSeg">
        <button data-val="sip">СИП</button>
        <button data-val="karkas">Каркас</button>
        <button data-val="gazoblok" class="active">Газоблок</button>
        <button data-val="kirpich">Кирпич</button>
        <button data-val="rakushechnik">Ракушечник</button>
        <button data-val="keramzit">Керамзитоблок</button>
      </div>

      <label>Толщина стены</label>
      <div class="thickness-row" id="thicknessRow"></div>

      <div class="section-title">Фундамент</div>
      <label>Тип</label>
      <div class="row3" id="foundTypeRow"></div>

      <label>Глубина заложения</label>
      <div class="row3" id="foundDepthRow"></div>

      <label>Ширина ленты</label>
      <div class="row3" id="foundWidthRow"></div>

      <label>Тип пола</label>
      <div class="row3" id="floorTypeRow"></div>

      <div class="section-title">Полуподвал / цоколь</div>
      <div class="toggle-row" id="tsokolToggle">
        <span>Добавить цоколь<small>Отдельный уровень ниже земли</small></span>
        <div class="toggle-switch"></div>
      </div>
      <div class="tsokol-filters" id="tsokolFilters">
        <label>Высота</label>
        <div class="row3" id="tsokolHeightRow"></div>
        <label>Материал стен</label>
        <div class="row3" id="tsokolMaterialRow"></div>
        <label>Ширина стены</label>
        <div class="row3" id="tsokolWidthRow"></div>
      </div>

      <div class="section-title">Окна и фасад</div>
      <label>Окна</label>
      <select id="windowsSelect"></select>

      <label>Количество окон</label>
      <div class="area-row" style="gap:8px;">
        <input type="number" id="winCountInput" value="8" min="0" max="60" style="font-size:22px;width:70px;" />
        <span>шт</span>
      </div>

      <label>Размер окна</label>
      <div class="row3" id="winSizeRow"></div>

      <label>Дверей, шт</label>
      <div class="cp-field" style="max-width:140px;"><div class="cp-inputs"><input type="number" id="doorCountInput" min="0" max="10"></div></div>

      <label>Площадь двери, м²</label>
      <div class="cp-field" style="max-width:140px;"><div class="cp-inputs"><input type="number" id="doorAreaInput" step="0.1" min="0.5" max="5"></div></div>

      <div class="custom-note show" id="openingsNoteMain"></div>

      <label>Отделка фасада</label>
      <select id="facadeSelect"></select>

      <div class="section-title">Отделка помещений</div>
      <label>Уровень</label>
      <div class="finish-list" id="finishList">
        <div class="finish-opt" data-val="box">
          <span class="dot"></span>
          <span>Только коробка<small>Стены, перекрытия, кровля — без инженерии и отделки</small></span>
        </div>
        <div class="finish-opt active" data-val="rough">
          <span class="dot"></span>
          <span>Черновая отделка<small>+ инженерные сети, штукатурка, стяжка</small></span>
        </div>
        <div class="finish-opt" data-val="full">
          <span class="dot"></span>
